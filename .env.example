# Copy this file to .env and replace every placeholder before running locally.
# Never commit .env or any real API key/password.

# DeepSeek is used for semantic routing, specialist answers and synthesis.
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=20
AGENT_ROUTER_ENABLED=auto

# Local Ollama embedding model for book/course knowledge retrieval.
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_TIMEOUT_SECONDS=30
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

# Authentication and web server.
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters
COOKIE_SECURE=false
APP_HOST=0.0.0.0
APP_PORT=8801
CORS_ALLOW_ORIGINS=http://127.0.0.1:8801,http://localhost:8801

# Host-run development uses the MySQL port published by docker-compose.yml.
# The Docker application container overrides this to db:3306 automatically.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=replace-with-a-strong-database-password
DB_NAME=university
MYSQL_ROOT_PASSWORD=replace-with-the-same-strong-database-password
MYSQL_PUBLISHED_PORT=3307
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ISOLATION_LEVEL=READ COMMITTED

# Official archive storage. Keep this outside a public/static directory in production.
ARCHIVE_STORAGE_DIR=data/archive_files
MAX_ARCHIVE_FILE_MB=20

# Optional Milvus-backed RAG module for the independent classics corpus.
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_DATABASE=ai0522
MILVUS_TIMEOUT_SECONDS=3

# Optional local source directory used by the RAG ingestion scripts.
# Use an absolute path or place private source files under data/novels/.
NOVEL_SOURCE_DIR=./data/novels
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=80
RAG_BATCH_SIZE=10
RAG_DEFAULT_TOP_K=5
RAG_RRF_K=60

# Demo lists intentionally stay small for the UI.
DEMO_LIMIT=3
